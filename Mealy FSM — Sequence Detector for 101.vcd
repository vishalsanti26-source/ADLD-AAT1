//DESIGN
`timescale 1ns/1ps

module mealy_101_detector(
    input clk,
    input reset,
    input din,
    output reg detected
);

    reg [1:0] state;
    localparam S0  = 2'b00,
               S1  = 2'b01,
               S10 = 2'b10;

    always @(posedge clk) begin
        if (reset) begin
            state    <= S0;
            detected <= 1'b0;
        end
        else begin
            detected <= 1'b0;
            case (state)
                S0: begin
                    if (din) state <= S1;
                    else     state <= S0;
                end
                S1: begin
                    if (din) state <= S1;
                    else     state <= S10;
                end
                S10: begin
                    if (din) begin
                        state    <= S1;
                        detected <= 1'b1;
                    end
                    else begin
                        state    <= S0;
                    end
                end
                default: begin
                    state    <= S0;
                    detected <= 1'b0;
                end
            endcase
        end
    end

endmodule

//TB
`timescale 1ns/1ps

module mealy_101_detector_tb;
    reg clk, reset, din;
    wire detected;
    integer i;
    reg [7:0] bits;

    // Instantiate the Mealy FSM
    mealy_101_detector dut (
        .clk(clk), 
        .reset(reset), 
        .din(din), 
        .detected(detected)
    );

    // Clock generator: 10ns period
    always #5 clk = ~clk;

    initial begin
        // Setup VCD file generation for waveform simulation
        $dumpfile("mealy_101_detector.vcd");
        $dumpvars(0, mealy_101_detector_tb);

        clk = 0;
        reset = 1;
        din = 0;
        bits = 8'b00101101; // Sequence testing 101 (overlapping supported)
        
        #12 reset = 0;
        
        for (i = 7; i >= 0; i = i - 1) begin
            din = bits[i];
            @(posedge clk);
            #1;
            $display("Time=%0t | Input=%b | Detected=%b", $time, din, detected);
        end
        
        $finish;
    end

endmodule
