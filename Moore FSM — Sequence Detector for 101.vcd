//DESIGN
`timescale 1ns/1ps

module moore_101_detector(
    input clk,
    input reset,
    input din,
    output reg detected
);

    reg [1:0] state;
    localparam S0   = 2'b00,
               S1   = 2'b01,
               S10  = 2'b10,
               S101 = 2'b11;

    always @(posedge clk) begin
        if (reset) begin
            state    <= S0;
            detected <= 1'b0;
        end
        else begin
            case (state)
                S0:   if (din) state <= S1;   else state <= S0;
                S1:   if (din) state <= S1;   else state <= S10;
                S10:  if (din) state <= S101; else state <= S0;
                S101: if (din) state <= S1;   else state <= S10;
                default: state <= S0;
            endcase
            
            // Moore output depends only on the current state
            detected <= (state == S101);
        end
    end

endmodule

//TB
`timescale 1ns/1ps

module moore_101_detector_tb;
    reg clk, reset, din;
    wire detected;
    integer i;
    reg [7:0] bits;

    // Instantiate the Moore FSM
    moore_101_detector dut (
        .clk(clk), 
        .reset(reset), 
        .din(din), 
        .detected(detected)
    );

    // Clock generator: 10ns period
    always #5 clk = ~clk;

    initial begin
        // Setup VCD file generation for waveform simulation
        $dumpfile("moore_101_detector.vcd");
        $dumpvars(0, moore_101_detector_tb);

        clk = 0;
        reset = 1;
        din = 0;
        bits = 8'b00101101; // Sequence testing 101
        
        #12 reset = 0;
        
        for (i = 7; i >= 0; i = i - 1) begin
            din = bits[i];
            @(posedge clk);
            #1;
            $display("Time=%0t | Input=%b | Detected=%b", $time, din, detected);
        end
        
        $finish;
    end

endmodule
