//DESIGN
`timescale 1ns/1ps

module barrel_shifter4(
    input [3:0] data_in,
    input [1:0] shift_amt,
    input direction,
    output reg [3:0] data_out
);

always @(*) begin
    if(direction == 1'b0)
        data_out = data_in << shift_amt;  // Left Shift
    else
        data_out = data_in >> shift_amt;  // Right Shift
end

endmodule

//TB
`timescale 1ns/1ps

module barrel_shifter4_tb;
    reg [3:0] data_in;
    reg [1:0] shift_amt;
    reg direction;
    wire [3:0] data_out;
    integer i;

    // Instantiate the Barrel Shifter
    barrel_shifter4 dut (
        .data_in(data_in),
        .shift_amt(shift_amt),
        .direction(direction),
        .data_out(data_out)
    );

    initial begin
        // Setup VCD file generation for waveform simulation
        $dumpfile("barrel_shifter4.vcd");
        $dumpvars(0, barrel_shifter4_tb);

        data_in = 4'b1011;
        
        // Test Left Shift (direction = 0)
        direction = 0;
        for(i = 0; i < 4; i = i + 1) begin
            shift_amt = i;
            #10;
            $display("Left Shift | amt=%d | data_in=%b | data_out=%b", shift_amt, data_in, data_out);
        end
        
        // Test Right Shift (direction = 1)
        direction = 1;
        for(i = 0; i < 4; i = i + 1) begin
            shift_amt = i;
            #10;
            $display("Right Shift | amt=%d | data_in=%b | data_out=%b", shift_amt, data_in, data_out);
        end
        
        $finish;
    end

endmodule
