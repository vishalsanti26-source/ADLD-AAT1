//DESIGN
`timescale 1ns/1ps

module divide_by_n #(
    parameter N = 8
)(
    input clk,
    input reset,
    output reg clk_div
);

    integer count;
    localparam HALF = (N < 2) ? 1 : (N / 2);

    always @(posedge clk) begin
        if (reset) begin
            count <= 0;
            clk_div <= 1'b0;
        end
        else if (count >= HALF - 1) begin
            count <= 0;
            clk_div <= ~clk_div;
        end
        else begin
            count <= count + 1;
        end
    end

endmodule

//TB
`timescale 1ns/1ps

module divide_by_n_tb;
    reg clk, reset;
    wire clk_div;

    // Instantiate the Divide-by-N Counter with N = 8
    divide_by_n #(.N(8)) dut (
        .clk(clk), 
        .reset(reset), 
        .clk_div(clk_div)
    );

    // Clock generator: 10ns period
    always #5 clk = ~clk;

    initial begin
        // Setup VCD file generation for waveform simulation
        $dumpfile("divide_by_n.vcd");
        $dumpvars(0, divide_by_n_tb);

        clk = 0;
        reset = 1;
        #12 reset = 0;
        
        repeat(30) begin
            @(posedge clk);
            #1;
            $display("Time=%0t | Divided Clock=%b", $time, clk_div);
        end
        
        $finish;
    end

endmodule
