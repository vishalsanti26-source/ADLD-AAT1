//DESIGN
`timescale 1ns/1ps

module asynchronous_counter4(
    input clk,
    input reset,
    output reg [3:0] q
);

    always @(posedge clk or posedge reset) begin
        if(reset)
            q[0] <= 1'b0;
        else
            q[0] <= ~q[0];
    end

    always @(negedge q[0] or posedge reset) begin
        if(reset)
            q[1] <= 1'b0;
        else
            q[1] <= ~q[1];
    end

    always @(negedge q[1] or posedge reset) begin
        if(reset)
            q[2] <= 1'b0;
        else
            q[2] <= ~q[2];
    end

    always @(negedge q[2] or posedge reset) begin
        if(reset)
            q[3] <= 1'b0;
        else
            q[3] <= ~q[3];
    end

endmodule

//TB
`timescale 1ns/1ps

module asynchronous_counter4_tb;
    reg clk, reset;
    wire [3:0] q;

    // Instantiate the Asynchronous Counter
    asynchronous_counter4 dut (
        .clk(clk), 
        .reset(reset), 
        .q(q)
    );

    // Clock generator: 10ns period
    always #5 clk = ~clk;

    initial begin
        // Setup VCD file generation for waveform simulation
        $dumpfile("asynchronous_counter4.vcd");
        $dumpvars(0, asynchronous_counter4_tb);

        clk = 0;
        reset = 1;
        #12 reset = 0;
        
        repeat(20) begin
            @(posedge clk);
            #2;
            $display("Time=%0t | Asynchronous Counter = %b", $time, q);
        end
        
        $finish;
    end

endmodule
